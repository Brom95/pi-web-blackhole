diff --git a/src/om/web-bridge.ts b/src/om/web-bridge.ts
new file mode 100644
index 0000000..3722c70
--- /dev/null
+++ b/src/om/web-bridge.ts
@@ -0,0 +1,106 @@
+/**
+ * pi-web settings bridge — the other half of the pi-blackhole-web plugin.
+ *
+ * The browser panel asks the pi-web server entry, which forwards here over the
+ * hosted session's Pi event bus. Everything this answers comes from pi-blackhole's
+ * own ConfigManager singleton: `getFields` is the schema the terminal modal already
+ * draws, `load` is the merged value set, `inspect().winners` says which scope set
+ * each key, and `save` is the same validated write the modal performs. Nothing here
+ * restates a field, a range, or a config path, so the web panel cannot drift from the
+ * terminal settings surface.
+ *
+ * Opening the panel sends no message to the LLM: this only answers on the bus.
+ */
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+
+const REQUEST_CHANNEL = "pi-blackhole-web:settings";
+const REPLY_CHANNEL = "pi-blackhole-web:settings-reply";
+
+/** Field and UnifiedConfig are structural types this module deliberately does
+ *  not restate; the bridge reads them through their plain-object shape. */
+function asRecord(value: unknown): Record<string, unknown> {
+  return value as Record<string, unknown>;
+}
+
+/** Plain-JSON view of one schema field. Field objects carry methods and
+ *  defaults that must not cross the bus, so the shape is declared here. */
+function projectField(field: unknown): Record<string, unknown> {
+  const source = asRecord(field);
+  const projected: Record<string, unknown> = {
+    key: source.key,
+    label: source.label,
+    type: source.type,
+    value: source.value,
+  };
+  for (const optional of ["options", "min", "max", "step", "description", "readonly"]) {
+    if (source[optional] !== undefined) projected[optional] = source[optional];
+  }
+  return projected;
+}
+
+/** HTML form controls hand back strings; the schema says how to read each one. */
+function coerceToSchema(field: unknown, raw: unknown): unknown {
+  const type = asRecord(field).type;
+  if (type === "boolean") return raw === true || raw === "true";
+  if (type === "number") return Number(raw);
+  return String(raw);
+}
+
+async function handle(pi: ExtensionAPI, frame: unknown): Promise<void> {
+  const request = asRecord(frame ?? {});
+  try {
+    const { config, GLOBAL_CONFIG_DIR } = await import("../pi-base/blackhole-settings.js");
+    const cwd = typeof request.cwd === "string" ? request.cwd : process.cwd();
+    const scope =
+      request.scope === "project" || request.scope === "session"
+        ? (request.scope as "project" | "session")
+        : "global";
+    const loaded = config.load(cwd, GLOBAL_CONFIG_DIR);
+
+    if (request.action === "set") {
+      const fields = config.getFields(loaded);
+      const byKey = new Map(fields.map((field) => [asRecord(field).key, field]));
+      const merged = { ...loaded };
+      const changes = Array.from((request.changes as unknown[]) || []);
+      const { validateFieldValue } = await import("../pi-base/settings/validate-field.js");
+      for (const change of changes) {
+        const entry = asRecord(change ?? {});
+        const field = byKey.get(entry.key);
+        // Unknown keys are refused, not silently dropped: a stale panel must not
+        // invent a config key.
+        if (!field) throw new Error(`unknown setting: ${String(entry.key)}`);
+        const value = coerceToSchema(field, entry.value);
+        // pi-blackhole's own validator supplies the refusal reason, shown
+        // verbatim: ConfigManager.save skips an invalid value silently, so the
+        // reason is surfaced here rather than restated by this bridge.
+        const warning = validateFieldValue(field, value);
+        if (warning) throw new Error(warning);
+        asRecord(merged)[String(entry.key)] = value;
+      }
+      // ConfigManager.save runs the same validation the terminal modal uses and
+      // throws with a human-readable reason, which the panel shows verbatim.
+      config.save(merged, scope, cwd, GLOBAL_CONFIG_DIR);
+    }
+
+    const current = config.load(cwd, GLOBAL_CONFIG_DIR);
+    const inspection = config.inspect(cwd, GLOBAL_CONFIG_DIR);
+    pi.events.emit(
+      REPLY_CHANNEL,
+      {
+        fields: config.getFields(current).map(projectField),
+        values: current,
+        winners: inspection.winners,
+        scopes: config.getScopes(),
+      },
+    );
+  } catch (error) {
+    // A failed write still replies, so the panel can show why it was refused.
+    pi.events.emit(REPLY_CHANNEL, { error: String(error) });
+  }
+}
+
+export function registerWebBridge(pi: ExtensionAPI): void {
+  pi.events.on(REQUEST_CHANNEL, (frame) => {
+    void handle(pi, frame);
+  });
+}
